node_modules/
*.log

# Scratch harness pages and rendered screenshots for the how-to-use images.
.teaching/

# The built userscript is the distribution channel, not a throwaway artifact:
# Tampermonkey fetches it from main by raw URL, so it has to be a real file in
# the repo. Only ever rebuild and commit it on main — a generated 200KB bundle
# tracked on feature branches conflicts on every merge.
dist/*
!dist/illyriad-sov-scanner.user.js

# Markdown is maintained outside this repo, README excepted. The spec docs are
# worth keeping to hand, but the code does not cite them — a comment has to
# explain the code on its own, since the section it would point at is not here.
*.md
!README.md
