{
  "name": "illyriad-sov-scanner",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Finds the best places on the World Map to build a sovereignty city, and plans which tiles to claim around them.",
  "scripts": {
    "build": "node build.mjs",
    "release": "node build.mjs --release",
    "watch": "node build.mjs --watch",
    "mockups": "node scripts/mockups.mjs",
    "test": "node --test",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=18"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0"
  }
}
