{
  "name": "illyriad-sov-scanner",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Finds the best places on the World Map to build a sovereignty city, and plans which tiles to claim around them.",
  "scripts": {
    "build": "node build.mjs",
    "release": "node build.mjs --release",
    "watch": "node build.mjs --watch",
    "mockups": "node scripts/mockups.mjs",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
